{
  "name": "\u05de\u05d7\u05d9\u05e7\u05ea \u05ea\u05d6\u05de\u05d5\u05e0\u05d9 \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05d1\u05d1\u05d9\u05d8\u05d5\u05dc/\u05de\u05d7\u05d9\u05e7\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2",
  "description": "\u05db\u05e9\u05d0\u05d9\u05e8\u05d5\u05e2 \u05de\u05ea\u05e2\u05d3\u05db\u05df \u05d5\u05e9\u05d3\u05d4 \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e9\u05ea\u05e0\u05d4 - \u05de\u05d5\u05d7\u05e7 \u05ea\u05d6\u05de\u05d5\u05e0\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d7\u05d3\u05e9.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Event"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cancelScheduledNotifications",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "cancelScheduledNotifications"
  }
}