{
  "name": "Event Notification Trigger",
  "description": "Handle Event changes for notifications",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) or (.trigger.changed_fields | index(\"event_date\") != null) or (.trigger.changed_fields | index(\"event_time\") != null) or (.trigger.changed_fields | index(\"location\") != null) or (.trigger.changed_fields | index(\"concept\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Event"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "event_notification_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleEntityEvents",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "handleEntityEvents"
  }
}