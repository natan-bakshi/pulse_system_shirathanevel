{
  "name": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05e4\u05e8\u05d8\u05d9 \u05e1\u05e4\u05e7 \u05dc\u05de\u05e9\u05ea\u05de\u05e9",
  "description": "\u05db\u05e9\u05e1\u05e4\u05e7 \u05e0\u05d5\u05e6\u05e8/\u05de\u05ea\u05e2\u05d3\u05db\u05df \u05e2\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05d8\u05dc\u05e4\u05d5\u05df/\u05de\u05d9\u05d9\u05dc/\u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8 - \u05de\u05e9\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d7\u05e1\u05e8\u05d9\u05dd \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05ea\u05d5\u05d0\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea (\u05d8\u05dc\u05e4\u05d5\u05df, \u05e9\u05dd, \u05ea\u05e4\u05e7\u05d9\u05d3 supplier).",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"phone\") != null) or (.trigger.changed_fields | index(\"contact_emails\") != null) or (.trigger.changed_fields | index(\"contact_person\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Supplier"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncEntityToUser",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncEntityToUser"
  }
}