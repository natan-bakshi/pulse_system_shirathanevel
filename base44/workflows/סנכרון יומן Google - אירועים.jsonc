{
  "name": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d9\u05d5\u05de\u05df Google - \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd",
  "description": "\u05db\u05d0\u05e9\u05e8 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e0\u05d5\u05e6\u05e8, \u05de\u05ea\u05e2\u05d3\u05db\u05df \u05d0\u05d5 \u05e0\u05de\u05d7\u05e7 - \u05de\u05e1\u05e0\u05db\u05e8\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05d9\u05d5\u05de\u05e0\u05d9 Google \u05e9\u05dc \u05d4\u05de\u05e0\u05d4\u05dc \u05d5\u05d4\u05e1\u05e4\u05e7\u05d9\u05dd \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05d9\u05dd",
