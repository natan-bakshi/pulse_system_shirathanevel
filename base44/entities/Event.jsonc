{
  "name": "Event",
  "type": "object",
  "properties": {
    "stored_card_qa_only": {
      "type": "boolean",
      "default": false,
      "description": "Dedicated disposable QA event; never enable on a real customer event"
    },
    "billing_customer_id": {
      "type": "string",
      "description": "Explicit billing customer shared by this customer’s events"
    },
    "event_name": {
      "type": "string",
      "description": "שם האירוע"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "bar_mitzvah",
        "bat_mitzvah",
        "wedding",
        "other"
      ],
      "description": "סוג האירוע"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך האירוע"
    },
    "event_time": {
      "type": "string",
      "description": "שעת האירוע"
    },
    "location": {
      "type": "string",
      "description": "מיקום האירוע"
    },
    "concept": {
      "type": "string",
      "description": "קונספט האירוע"
    },
    "family_name": {
      "type": "string",
      "description": "שם המשפחה"
    },
    "child_name": {
      "type": "string",
      "description": "שם הילד/ה"
    },
    "city": {
      "type": "string",
      "description": "עיר מגורים"
    },
    "guest_count": {
      "type": "number",
      "description": "מספר אורחים"
    },
    "status": {
      "type": "string",
      "enum": [
        "quote",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "quote",
      "description": "סטטוס האירוע"
    },
    "primary_currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD"
      ],
      "default": "ILS",
      "description": "מטבע ראשי של האירוע"
    },
    "total_price": {
      "type": "number",
      "description": "מחיר כולל - שדה ישן. נא להשתמש ב-all_inclusive_price"
    },
    "all_inclusive": {
      "type": "boolean",
      "default": false,
      "description": "האם החבילה היא הכל כלול"
    },
    "all_inclusive_price": {
      "type": "number",
      "description": "מחיר חבילת הכל כלול"
    },
    "all_inclusive_includes_vat": {
      "type": "boolean",
      "default": false,
      "description": "האם מחיר החבילה כולל מע''מ"
    },
    "total_override": {
      "type": "number",
      "description": "דריסת המחיר הכולל"
    },
    "total_override_includes_vat": {
      "type": "boolean",
      "default": true,
      "description": "האם דריסת המחיר כוללת מע''מ"
    },
    "is_price_per_guest": {
      "type": "boolean",
      "default": false,
      "description": "האם התמחור הוא לפי מחיר למשתתף"
    },
    "price_per_guest": {
      "type": "number",
      "description": "המחיר למשתתף בודד (מחושב: מחיר כולל / מספר אורחים)"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "סכום ההנחה"
    },
    "discount_before_vat": {
      "type": "boolean",
      "default": false,
      "description": "האם ההנחה מחושבת לפני מע''מ"
    },
    "discount_reason": {
      "type": "string",
      "description": "סיבת ההנחה"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "fixed",
        "per_guest"
      ],
      "default": "fixed",
      "description": "סוג ההנחה: fixed = הנחה קבועה על כל האירוע, per_guest = הנחה לכל משתתף (מוכפלת במספר אורחים)"
    },
    "notes": {
      "type": "string",
      "description": "הערות כלליות"
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "לוח זמנים של האירוע"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "שם ההורה"
          },
          "phone": {
            "type": "string",
            "description": "טלפון"
          },
          "email": {
            "type": "string",
            "description": "אימייל"
          },
          "id": {
            "type": "string",
            "description": "מזהה קבוע לאיש קשר"
          },
          "role": {
            "type": "string",
            "description": "תפקיד איש הקשר באירוע"
          },
          "custom_fields": {
            "type": "object",
            "additionalProperties": true,
            "description": "ערכי שדות מידע נוספים לפי מזהה קבוע"
          },
          "custom_field_labels": {
            "type": "object",
            "additionalProperties": true,
            "description": "כותרות להצגת המידע הנוסף"
          },
          "client_access": {
            "type": "boolean",
            "description": "תאימות לרשומות ישנות: false שומר איש קשר מידע ללא שינוי בזכאות לקוח קיימת"
          }
        }
      },
      "description": "רשימת הורים/אנשי קשר"
    },
    "organizer_contacts": {
      "type": "string",
      "description": "JSON: מערך אנשי קשר של המזמין [{name, phone, email, ...שדות_נוספים}]"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "מזהה האירוע ביומן Google (למנהל)"
    },
    "client_google_calendar_event_id": {
      "type": "string",
      "description": "מזהה האירוע ביומן Google של הלקוח"
    },
    "client_google_calendar_id": {
      "type": "string",
      "description": "מזהה יומן Google של הלקוח לאירוע זה"
    },
    "admin_other_google_calendar_ids": {
      "type": "string",
      "description": "מזהי אירועי יומן גוגל של מנהלים נוספים בפורמט JSON - אובייקט עם userId כמפתח ומזהה אירוע כערך"
    },
    "quote_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string",
            "description": "URI של קובץ ה-PDF באחסון הפרטי"
          },
          "file_name": {
            "type": "string",
            "description": "שם הקובץ"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "תאריך ושעת יצירת ההצעה"
          },
          "created_by_user_name": {
            "type": "string",
            "description": "שם המשתמש שיצר את ההצעה"
          },
          "event_status": {
            "type": "string",
            "description": "סטטוס האירוע בזמן הנפקת ההצעה"
          }
        }
      },
      "description": "היסטוריית הצעות מחיר שהונפקו כ-PDF"
    },
    "date_change_pending_action": {
      "type": "boolean",
      "default": false,
      "description": "דגל המסמן ששינוי תאריך אירוע ממתין להחלטת מנהל לגבי הספקים המשובצים"
    },
    "previous_event_date": {
      "type": "string",
      "format": "date",
      "description": "התאריך הקודם של האירוע (לפני שינוי) - לצורך שאלת המנהל לגבי הספקים"
    },
    "previous_event_time": {
      "type": "string",
      "description": "השעה הקודמת של האירוע (לפני שינוי) - לצורך שאלת המנהל לגבי הספקים"
    },
    "organizer_type": {
      "type": "string",
      "description": "סוג ההזמנה (שם מתוך QuoteOrganizerType). ריק = ברירת מחדל"
    },
    "custom_organizer_fields": {
      "type": "string",
      "description": "ערכי שדות דינמיים בפורמט JSON: {field_id: value}"
    },
    "services_section_title": {
      "type": "string",
      "description": "כותרת מקטע השירותים/חבילת ההפקה בהצעת המחיר ובכרטיסיית השירותים. ריק = חבילת ההפקה כוללת"
    },
    "standalone_services_title": {
      "type": "string",
      "description": "כותרת משנה לפני שירותים בודדים ללא חבילה. ריק = ללא כותרת"
    },
    "external_services_title": {
      "type": "string",
      "description": "כותרת מקטע שירותים חיצוניים שלא כלולים בסיכום הכספי. ריק = שירותים נוספים"
    },
    "contacts_schema_version": {
      "type": "number",
      "description": "גרסת אנשי קשר. 2: רשימת parents היא מקור האמת; organizer_contacts נשמר לתאימות היסטורית בלבד"
    },
    "field_binding_version": {
      "type": "number",
      "description": "גרסת מעבר שדות קיימים; שינוי השדה מיועד למעבר נתונים מבוקר בלבד"
    },
    "closing_agreement_id": {
      "type": "string"
    },
    "closing_manual_override": {
      "type": "boolean"
    }
  },
  "required": [
    "event_name",
    "event_date",
    "family_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
