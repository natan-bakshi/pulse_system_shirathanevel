{
  "name": "WhatsAppInboundQuarantine",
  "type": "object",
  "description": "Owner-review-only record for authenticated Green callbacks with an unrecognized button shape. No raw message, phone, chat ID, token, original stanzaId or message body is stored. A record is NOT proof of supplier approval. Never automatically replays.",
  "properties": {
    "quarantine_key": {
      "type": "string",
      "description": "Domain-separated HMAC fingerprint of instance + provider event ID; no raw provider identifier"
    },
    "payload_mac": {
      "type": "string",
      "description": "Domain-separated HMAC of callback JSON to detect changed/replayed payloads; no raw content"
    },
    "provider": {
      "type": "string",
      "enum": [
        "green"
      ]
    },
    "company_id": {
      "type": "string",
      "description": "Fixed single-system scope shirat_hanevel"
    },
    "format_code": {
      "type": "string",
      "enum": [
        "unrecognized_interactive",
        "unrecognized_incoming"
      ],
      "description": "Sanitized general classification, not any supplier-supplied text"
    },
    "state": {
      "type": "string",
      "enum": [
        "needs_review"
      ],
      "default": "needs_review"
    },
    "provider_event_at": {
      "type": "string",
      "format": "date-time"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_code": {
      "type": "string",
      "description": "Allowlisted code only, no private content"
    },
    "recovery_version": {
      "type": "string",
      "description": "Optional future owner-approved encrypted recovery envelope version. Absent by default."
    },
    "recovery_status": {
      "type": "string",
      "enum": [
        "encrypted",
        "erased"
      ],
      "description": "Optional encryption state; no implication that the callback is processed or ACKed"
    },
    "recovery_key_id": {
      "type": "string",
      "description": "Opaque key version, never an actual secret; no key stored in entity"
    },
    "recovery_nonce": {
      "type": "string",
      "description": "96-bit random AES-GCM IV, authenticated against HMAC identity and expiration"
    },
    "recovery_ciphertext": {
      "type": "string",
      "description": "Optional AES-256-GCM encrypted minimal unknown interactive callback, never plaintext. Feature disabled until privacy and cleanup approval."
    },
    "recovery_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "After expiration, decryption is prohibited; physical deletion must be separately verified before LIVE"
    }
  },
  "required": [
    "quarantine_key",
    "payload_mac",
    "provider",
    "company_id",
    "format_code",
    "state",
    "registered_at",
    "review_code"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}