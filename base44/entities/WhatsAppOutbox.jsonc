{
  "name": "WhatsAppOutbox",
  "type": "object",
  "properties": {
    "chat_id": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "document"
      ]
    },
    "message_text": {
      "type": "string"
    },
    "document_url": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "in_app_notification_id": {
      "type": "string"
    },
    "mirror_sync_pending": {
      "type": "boolean",
      "default": false,
      "description": "Provider accepted but updating the related InApp mirror failed; the existing watchdog safely repairs only this mirror"
    },
    "mirror_sync_last_attempt_at": {
      "type": "string"
    },
    "client_message_delivery_id": {
      "type": "string"
    },
    "delivery_mirror_sync_pending": {
      "type": "boolean",
      "default": false,
      "description": "A terminal provider status exists in Outbox but updating ClientMessageDelivery or agreement copy state failed; repair source state only, never resend"
    },
    "delivery_mirror_sync_last_attempt_at": {
      "type": "string"
    },
    "card_setup_request_id": {
      "type": "string"
    },
    "event_service_id": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "accepted",
        "retry_wait",
        "unknown",
        "failed",
        "cancelled",
        "expired",
        "resolved"
      ],
      "default": "queued"
    },
    "available_at": {
      "type": "string"
    },
    "send_started_at": {
      "type": "string"
    },
    "worker_run_id": {
      "type": "string"
    },
    "worker_wake_reason": {
      "type": "string"
    },
    "job_claimed_at": {
      "type": "string"
    },
    "rate_ready_at": {
      "type": "string"
    },
    "prior_dispatch_at": {
      "type": "string"
    },
    "configured_interval_ms": {
      "type": "number"
    },
    "transport_started_at": {
      "type": "string"
    },
    "transport_finished_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "requested_provider": {
      "type": "string",
      "enum": [
        "green",
        "wasender"
      ]
    },
    "provider_message_id": {
      "type": "string"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "lease_token": {
      "type": "string"
    },
    "error_code": {
      "type": "number"
    },
    "last_error": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "max_attempts": {
      "type": "number",
      "default": 3
    },
    "last_status_at": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string"
    },
    "manual_action": {
      "type": "string"
    },
    "manual_action_by": {
      "type": "string"
    },
    "manual_action_at": {
      "type": "string"
    },
    "manual_review_note": {
      "type": "string"
    },
    "manual_retry_count": {
      "type": "number",
      "default": 0
    },
    "resolution": {
      "type": "string"
    }
  },
  "required": [
    "chat_id",
    "message_type",
    "status",
    "available_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}