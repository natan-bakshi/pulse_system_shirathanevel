{
  "name": "WhatsAppQueueControl",
  "type": "object",
  "properties": {
    "control_key": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "paused": {
      "type": "boolean",
      "default": false
    },
    "min_interval_seconds": {
      "type": "number",
      "default": 7
    },
    "wasender_interval_ms": {
      "type": "number",
      "default": 7000
    },
    "green_interval_ms": {
      "type": "number",
      "default": 7000
    },
    "last_provider": {
      "type": "string"
    },
    "max_messages_per_run": {
      "type": "number",
      "default": 16
    },
    "lease_owner": {
      "type": "string"
    },
    "lease_until": {
      "type": "string"
    },
    "last_dispatched_at": {
      "type": "string"
    },
    "last_green_dispatched_at": {
      "type": "string",
      "description": "Green API most recent transport claim; independently paced from WasenderAPI"
    },
    "last_wasender_dispatched_at": {
      "type": "string",
      "description": "WasenderAPI most recent transport claim; independently paced from Green API"
    },
    "next_allowed_at": {
      "type": "string"
    },
    "last_worker_at": {
      "type": "string"
    },
    "last_worker_run_id": {
      "type": "string"
    },
    "last_worker_wake_reason": {
      "type": "string"
    },
    "last_worker_finished_at": {
      "type": "string"
    },
    "last_batch_count": {
      "type": "number"
    },
    "last_batch_elapsed_ms": {
      "type": "number"
    },
    "last_invoked_at": {
      "type": "string"
    },
    "last_watchdog_at": {
      "type": "string",
      "description": "Authenticated five-minute watchdog last seen; updated even if no messages are due"
    },
    "last_invocation_result": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "wake_requested_at": {
      "type": "string"
    },
    "generation": {
      "type": "number",
      "default": 0
    },
    "enqueue_owner": {
      "type": "string"
    },
    "enqueue_until": {
      "type": "string"
    },
    "interactive_outbound_live_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Owner-reviewed future rollout safety fence. Default OFF; never set through draft WhatsApp settings or public queue admin."
    },
    "interactive_assignment_production_enabled": {
      "type": "boolean",
      "default": false,
      "description": "System-owner emergency switch for Green assignment reply buttons, OFF by default, inbound history remains valid when disabled"
    },
    "interactive_legacy_assignment_pilot_json": {
      "type": "string",
      "description": "Owner-signed two-day single-scope Green assignment pilot; no provider credentials, no business edits or queue activation"
    },
    "interactive_assignment_green_policy_json": {
      "type": "string",
      "description": "System owner only: versioned, disabled interactive assignment draft for Green API"
    },
    "interactive_assignment_wasender_policy_json": {
      "type": "string",
      "description": "System owner only: versioned, disabled interactive assignment draft for WasenderAPI"
    },
    "inbound_create_owner": {
      "type": "string",
      "description": "Independent CAS mutex for inbound receipt registration, never the send worker lease"
    },
    "inbound_create_until": {
      "type": "string",
      "description": "Bounded inbound registration mutex expiry; expired ownership is not proof of provider-event nonreceipt"
    },
    "inbound_guard_key": {
      "type": "string",
      "description": "Durable registration-in-progress fence: if not cleared, ALL new inbound registrations must halt for human reconciliation"
    },
    "unknown_create_owner": {
      "type": "string",
      "description": "Isolated CAS mutex for unknown Green callback metadata; never shares inbound receipt registration lock"
    },
    "unknown_create_until": {
      "type": "string",
      "description": "Unknown callback CAS lease expiration; not a licence to reset an unresolved guard"
    },
    "unknown_guard_key": {
      "type": "string",
      "description": "Persistent unknown-callback pre-CREATE fence; ambiguous create requires owner reconciliation, never auto-cleared"
    },
    "inbound_rate_window_started_at": {
      "type": "string",
      "description": "Future authenticated Green callback rate window (not active until approved endpoint rollout)"
    },
    "inbound_rate_count": {
      "type": "number",
      "description": "Future global callback count for current rate window; never used by the outbound worker"
    }
  },
  "required": [
    "control_key",
    "enabled",
    "paused",
    "min_interval_seconds",
    "lease_owner",
    "lease_until"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}