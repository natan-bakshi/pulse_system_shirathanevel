{
  "name": "ClientMessageDelivery",
  "type": "object",
  "properties": {
    "agreement_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "target_masked": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "provider_message_id": {
      "type": "string"
    },
    "attempted_at": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "error_code": {
      "type": "string",
      "description": "Sanitized reason category for an Outbox enqueue/receipt error. Never raw phone, message, token or provider secret."
    },
    "failure_phase": {
      "type": "string",
      "description": "Stage of failure, not proof that a provider did or did not receive a request."
    },
    "sent_at": {
      "type": "string"
    },
    "queued_at": {
      "type": "string"
    },
    "queue_job_id": {
      "type": "string"
    }
  },
  "required": [
    "agreement_id",
    "event_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}