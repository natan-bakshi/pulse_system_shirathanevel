{
  "name": "Payment",
  "type": "object",
  "properties": {
    "stored_card_operation_id": {
      "type": "string"
    },
    "billing_customer_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "description": "מזהה האירוע. ריק = סליקה כללית שאינה משויכת לאירוע"
    },
    "amount": {
      "type": "number",
      "description": "סכום התשלום"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD"
      ],
      "description": "מטבע התשלום"
    },
    "converted_amount": {
      "type": "number",
      "description": "סכום מומר למטבע האירוע"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך התשלום"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "check",
        "credit_card"
      ],
      "description": "אמצעי תשלום"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "cancelled",
        "failed"
      ],
      "default": "completed",
      "description": "סטטוס התשלום"
    },
    "notes": {
      "type": "string",
      "description": "הערות על התשלום"
    },
    "receipt_number": {
      "type": "string",
      "description": "מספר קבלה"
    },
    "receipt_image_url": {
      "type": "string",
      "description": "קישור לאסמכתא"
    },
    "invoice4u_payment_id": {
      "type": "string",
      "description": "מזהה סליקה ב-Invoice4U"
    },
    "invoice4u_clearing_status": {
      "type": "string",
      "description": "סטטוס סליקה"
    },
    "invoice4u_document_number": {
      "type": "string",
      "description": "מספר מסמך Invoice4U"
    },
    "invoice4u_callback_token": {
      "type": "string",
      "description": "אסימון אימות לקריאת חזרה"
    },
    "financial_document_id": {
      "type": "string",
      "description": "מזהה מסמך פיננסי"
    },
    "clearing_method": {
      "type": "string",
      "enum": [
        "hosted_page",
        "stored_card"
      ],
      "description": "שיטת סליקה"
    },
    "charge_type": {
      "type": "string",
      "enum": [
        "regular",
        "advance",
        "general",
        "manual",
        "exceptional"
      ],
      "description": "סוג החיוב: רגיל, מקדמה, סליקה כללית ללא אירוע, או תשלום ידני"
    },
    "auth_number": {
      "type": "string",
      "description": "מספר אסמכתא מחברת האשראי"
    },
    "card_suffix": {
      "type": "string",
      "description": "ארבע ספרות אחרונות של הכרטיס"
    },
    "processing_fee_amount": {
      "type": "number",
      "description": "סכום עמלת הסליקה שנוספה לחיוב"
    },
    "payer_name": {
      "type": "string",
      "description": "שם המשלם כפי שהוזן בדיאלוג הסליקה"
    },
    "payer_phone": {
      "type": "string",
      "description": "טלפון המשלם"
    },
    "payer_email": {
      "type": "string",
      "description": "אימייל המשלם"
    },
    "customer_name_on_card": {
      "type": "string",
      "description": "שם בעל הכרטיס כפי שחזר מהסליקה"
    },
    "is_interested_in_invoice": {
      "type": "boolean",
      "description": "בקשה לחשבונית"
    },
    "client_ip": {
      "type": "string",
      "description": "כתובת IP מהסליקה"
    },
    "document_language": {
      "type": "string",
      "enum": [
        "he",
        "en"
      ],
      "default": "he",
      "description": "שפת המסמך וההודעות ללקוח עבור תשלום זה"
    },
    "is_payment_link": {
      "type": "boolean",
      "default": false,
      "description": "האם התשלום נוצר כדרישת תשלום בקישור (ולא סליקה מיידית)"
    },
    "payment_link_url": {
      "type": "string",
      "description": "כתובת דף התשלום המאובטח שנשלחה ללקוח - לשליחה חוזרת ולתזכורות"
    },
    "link_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "מועד תפוגת קישור התשלום. לאחר מועד זה התשלום הממתין יבוטל אוטומטית"
    },
    "link_reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "האם נשלחה תזכורת ללקוח לפני תפוגת הקישור"
    },
    "agreement_id": {
      "type": "string"
    },
    "agreement_environment": {
      "type": "string"
    },
    "agreement_notice_id": {
      "type": "string"
    },
    "agreement_verified": {
      "type": "boolean"
    },
    "agreement_callback_busy": {
      "type": "boolean"
    }
  },
  "required": [
    "amount",
    "payment_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}