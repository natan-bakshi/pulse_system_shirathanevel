{
  "name": "Payment",
  "type": "object",
  "properties": {
    "stored_card_operation_id": {
      "type": "string"
    },
    "billing_customer_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD"
      ]
    },
    "converted_amount": {
      "type": "number"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "check",
        "credit_card"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "cancelled",
        "failed"
      ],
      "default": "completed"
    },
    "notes": {
      "type": "string"
    },
    "receipt_number": {
      "type": "string"
    },
    "receipt_image_url": {
      "type": "string"
    },
    "invoice4u_payment_id": {
      "type": "string"
    },
    "invoice4u_clearing_status": {
      "type": "string"
    },
    "invoice4u_document_number": {
      "type": "string"
    },
    "invoice4u_callback_token": {
      "type": "string"
    },
    "financial_document_id": {
      "type": "string"
    },
    "clearing_method": {
      "type": "string",
      "enum": [
        "hosted_page",
        "stored_card"
      ]
    },
    "charge_type": {
      "type": "string",
      "enum": [
        "regular",
        "advance",
        "general",
        "manual",
        "exceptional"
      ]
    },
    "auth_number": {
      "type": "string"
    },
    "card_suffix": {
      "type": "string"
    },
    "processing_fee_amount": {
      "type": "number"
    },
    "payer_name": {
      "type": "string"
    },
    "payer_phone": {
      "type": "string"
    },
    "payer_email": {
      "type": "string"
    },
    "customer_name_on_card": {
      "type": "string"
    },
    "is_interested_in_invoice": {
      "type": "boolean"
    },
    "client_ip": {
      "type": "string"
    },
    "document_language": {
      "type": "string",
      "enum": [
        "he",
        "en"
      ],
      "default": "he"
    },
    "is_payment_link": {
      "type": "boolean",
      "default": false
    },
    "payment_link_url": {
      "type": "string"
    },
    "link_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "link_reminder_sent": {
      "type": "boolean",
      "default": false
    },
    "agreement_id": {
      "type": "string"
    },
    "agreement_environment": {
      "type": "string"
    },
    "agreement_notice_id": {
      "type": "string"
    },
    "agreement_verified": {
      "type": "boolean"
    },
    "agreement_callback_busy": {
      "type": "boolean"
    },
    "agreement_callback": {
      "type": "object"
    },
    "agreement_callback_owner": {
      "type": "string"
    },
    "agreement_callback_started_at": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "payment_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}