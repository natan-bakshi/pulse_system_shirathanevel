{
  "name": "Payment",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2. \u05e8\u05d9\u05e7 = \u05e1\u05dc\u05d9\u05e7\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d0\u05d9\u05e0\u05d4 \u05de\u05e9\u05d5\u05d9\u05db\u05ea \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD"
      ],
      "description": "\u05de\u05d8\u05d1\u05e2 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "converted_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05de\u05d5\u05de\u05e8 \u05dc\u05de\u05d8\u05d1\u05e2 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "check",
        "credit_card"
      ],
      "description": "\u05d0\u05de\u05e6\u05e2\u05d9 \u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "cancelled",
        "failed"
      ],
      "default": "completed",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e2\u05dc \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "receipt_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e7\u05d1\u05dc\u05d4"
    },
    "receipt_image_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d0\u05e1\u05de\u05db\u05ea\u05d0"
    },
    "invoice4u_payment_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05dc\u05d9\u05e7\u05d4 \u05d1-Invoice4U"
    },
    "invoice4u_clearing_status": {
      "type": "string",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e1\u05dc\u05d9\u05e7\u05d4"
    },
    "invoice4u_document_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e1\u05de\u05da Invoice4U"
    },
    "invoice4u_callback_token": {
      "type": "string",
      "description": "\u05d0\u05e1\u05d9\u05de\u05d5\u05df \u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05e7\u05e8\u05d9\u05d0\u05ea \u05d7\u05d6\u05e8\u05d4"
    },
    "financial_document_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e1\u05de\u05da \u05e4\u05d9\u05e0\u05e0\u05e1\u05d9"
    },
    "clearing_method": {
      "type": "string",
      "enum": [
        "hosted_page"
      ],
      "description": "\u05e9\u05d9\u05d8\u05ea \u05e1\u05dc\u05d9\u05e7\u05d4"
    },
    "charge_type": {
      "type": "string",
      "enum": [
        "regular",
        "advance",
        "general",
        "manual"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d7\u05d9\u05d5\u05d1: \u05e8\u05d2\u05d9\u05dc, \u05de\u05e7\u05d3\u05de\u05d4, \u05e1\u05dc\u05d9\u05e7\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05dc\u05dc\u05d0 \u05d0\u05d9\u05e8\u05d5\u05e2, \u05d0\u05d5 \u05ea\u05e9\u05dc\u05d5\u05dd \u05d9\u05d3\u05e0\u05d9"
    },
    "auth_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d0\u05e1\u05de\u05db\u05ea\u05d0 \u05de\u05d7\u05d1\u05e8\u05ea \u05d4\u05d0\u05e9\u05e8\u05d0\u05d9"
    },
    "card_suffix": {
      "type": "string",
      "description": "\u05d0\u05e8\u05d1\u05e2 \u05e1\u05e4\u05e8\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc \u05d4\u05db\u05e8\u05d8\u05d9\u05e1"
    },
    "processing_fee_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05e2\u05de\u05dc\u05ea \u05d4\u05e1\u05dc\u05d9\u05e7\u05d4 \u05e9\u05e0\u05d5\u05e1\u05e4\u05d4 \u05dc\u05d7\u05d9\u05d5\u05d1"
    },
    "payer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05dc\u05dd \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05d6\u05df \u05d1\u05d3\u05d9\u05d0\u05dc\u05d5\u05d2 \u05d4\u05e1\u05dc\u05d9\u05e7\u05d4"
    },
    "payer_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05de\u05e9\u05dc\u05dd"
    },
    "payer_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05dc\u05dd"
    },
    "customer_name_on_card": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d1\u05e2\u05dc \u05d4\u05db\u05e8\u05d8\u05d9\u05e1 \u05db\u05e4\u05d9 \u05e9\u05d7\u05d6\u05e8 \u05de\u05d4\u05e1\u05dc\u05d9\u05e7\u05d4"
    },
    "is_interested_in_invoice": {
      "type": "boolean",
      "description": "\u05d1\u05e7\u05e9\u05d4 \u05dc\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "client_ip": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea IP \u05de\u05d4\u05e1\u05dc\u05d9\u05e7\u05d4"
    },
    "document_language": {
      "type": "string",
      "enum": [
        "he",
        "en"
      ],
      "default": "he",
      "description": "\u05e9\u05e4\u05ea \u05d4\u05de\u05e1\u05de\u05da \u05d5\u05d4\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05dc\u05dc\u05e7\u05d5\u05d7 \u05e2\u05d1\u05d5\u05e8 \u05ea\u05e9\u05dc\u05d5\u05dd \u05d6\u05d4"
    },
    "is_payment_link": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd \u05e0\u05d5\u05e6\u05e8 \u05db\u05d3\u05e8\u05d9\u05e9\u05ea \u05ea\u05e9\u05dc\u05d5\u05dd \u05d1\u05e7\u05d9\u05e9\u05d5\u05e8 (\u05d5\u05dc\u05d0 \u05e1\u05dc\u05d9\u05e7\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea)"
    },
    "payment_link_url": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d3\u05e3 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd \u05d4\u05de\u05d0\u05d5\u05d1\u05d8\u05d7 \u05e9\u05e0\u05e9\u05dc\u05d7\u05d4 \u05dc\u05dc\u05e7\u05d5\u05d7 - \u05dc\u05e9\u05dc\u05d9\u05d7\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea \u05d5\u05dc\u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea"
    },
    "link_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05ea\u05e4\u05d5\u05d2\u05ea \u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd. \u05dc\u05d0\u05d7\u05e8 \u05de\u05d5\u05e2\u05d3 \u05d6\u05d4 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd \u05d4\u05de\u05de\u05ea\u05d9\u05df \u05d9\u05d1\u05d5\u05d8\u05dc \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
    },
    "link_reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e9\u05dc\u05d7\u05d4 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05dc\u05dc\u05e7\u05d5\u05d7 \u05dc\u05e4\u05e0\u05d9 \u05ea\u05e4\u05d5\u05d2\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8"
    }
  },
  "required": [
    "amount",
    "payment_date"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}